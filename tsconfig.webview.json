{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist/webview",
    "rootDir": "src/webview",
    "sourceMap": true
  },
  "include": ["src/webview/**/*.ts", "src/ui/protocol.d.ts"]
}
